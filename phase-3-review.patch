+            'secret-value'
+        ].forEach((forbidden) => assert.equal(
+            serialized.includes(forbidden),
+            false,
+            forbidden
+        ));
+    });
+});
+
+function createPerception(
+    id: string,
+    previous?: PagePerception
+): PagePerception {
+    const dom = createObservation(id);
+    return {
+        perceptionId: `perception-${ id }`,
+        capturedAt: '2026-08-31T00:00:00.000Z',
