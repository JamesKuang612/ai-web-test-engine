+        assert.equal(progress.status, 'complete');
+    });
+
+    it('模型安全视图不包含物理定位和输入真实值', () => {
+        const perception = createPerception('after');
+        const serialized = JSON.stringify(createRecoveryPlanningView(perception));
+
+        [
+            'candidateId',
+            'domCandidateId',
+            'locatorHints',
+            'attributes',
+            'boundingBox',
