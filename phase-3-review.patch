     }
 }
+
+function isScrollValue(value: JsonValue | undefined): value is {
+    direction: 'up' | 'down',
+    amount: 'small' | 'medium' | 'page'
+} {
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+        return false;
+    }
+    return (value.direction === 'up' || value.direction === 'down')
+        && (
+            value.amount === 'small'
+            || value.amount === 'medium'
+            || value.amount === 'page'
+        );
+}
