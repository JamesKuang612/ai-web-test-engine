{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Config": {
            "additionalProperties": false,
            "description": "聚合服务启动所需的系统、HTTP、存储和组件配置。",
            "properties": {
                "components": {
                    "$ref": "#/definitions/IComponentsConf"
                },
                "env": {
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                },
                "includes": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "server": {
                    "$ref": "#/definitions/IServerConf"
                },
                "storage": {
                    "$ref": "#/definitions/IStorageConf"
                },
                "system": {
                    "$ref": "#/definitions/ISystemConf"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "components",
                "env",
                "hostname",
                "server",
                "storage",
                "system",
                "version"
            ],
            "type": "object"
        },
        "IBrowserComponentConf": {
            "additionalProperties": false,
            "description": "Playwright 浏览器会话的本地启动参数。",
            "properties": {
                "headless": {
                    "type": "boolean"
                },
                "viewport": {
                    "additionalProperties": false,
                    "properties": {
                        "height": {
                            "type": "number"
                        },
                        "width": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "height",
                        "width"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "headless",
                "viewport"
            ],
            "type": "object"
        },
        "IComponentsConf": {
            "additionalProperties": false,
            "description": "当前服务需要的可选组件配置集合。",
            "properties": {
                "browser": {
                    "$ref": "#/definitions/IBrowserComponentConf"
                },
                "llm": {
                    "$ref": "#/definitions/ILlmComponentConf"
                },
                "visual_grounding": {
                    "$ref": "#/definitions/IVisualGroundingComponentConf",
                    "description": "兼容尚未增加该字段的本机私有覆盖配置。"
                }
            },
            "required": [
                "browser",
                "llm"
            ],
            "type": "object"
        },
        "IConsoleLogConf": {
            "additionalProperties": false,
            "properties": {
                "colorize": {
                    "description": "开启彩色输出",
                    "type": "boolean"
                },
                "enabled": {
                    "description": "是否启用日志记录",
                    "type": "boolean"
                },
                "level": {
                    "description": "日志级别",
                    "type": "string"
                }
            },
            "required": [
                "enabled",
                "level"
            ],
            "type": "object"
        },
        "IFileLogConf": {
            "additionalProperties": false,
            "properties": {
                "dir": {
                    "description": "日志输出目录",
                    "type": "string"
                },
                "enabled": {
                    "description": "是否启用日志记录",
                    "type": "boolean"
                },
                "level": {
                    "description": "日志级别",
                    "type": "string"
                },
                "rotate_days": {
                    "description": "历史日志文件的保留天数。",
                    "type": "number"
                },
                "zip": {
                    "description": "是否压缩历史日志文件。",
                    "type": "boolean"
                }
            },
            "required": [
                "enabled",
                "level"
            ],
            "type": "object"
        },
        "ILlmComponentConf": {
            "additionalProperties": false,
            "description": "模型 Provider 配置；HTTP API Key 只允许由本机私有配置覆盖。",
            "properties": {
                "api_key": {
                    "type": "string"
                },
                "base_url": {
                    "type": "string"
                },
                "codex_command": {
                    "type": "string"
                },
                "model": {
                    "type": "string"
                },
                "protocol": {
                    "$ref": "#/definitions/LlmApiProtocol"
                },
                "provider": {
                    "$ref": "#/definitions/LlmProvider"
                },
                "reasoning_effort": {
                    "$ref": "#/definitions/LlmReasoningEffort"
                },
                "service_tier": {
                    "const": "priority",
                    "description": "Codex 可选的加速服务档位；未配置时使用账户默认档位。",
                    "type": "string"
                }
            },
            "required": [
                "api_key",
                "base_url",
                "codex_command",
                "model",
                "protocol",
                "provider",
                "reasoning_effort"
            ],
            "type": "object"
        },
        "IServerConf": {
            "additionalProperties": false,
            "description": "HTTP、Session 和 Cookie 相关的服务端配置。",
            "properties": {
                "cookie": {
                    "additionalProperties": false,
                    "properties": {
                        "policy": {
                            "additionalProperties": false,
                            "properties": {
                                "domain": {
                                    "type": "string"
                                },
                                "httpOnly": {
                                    "type": "boolean"
                                },
                                "maxAge": {
                                    "type": "number"
                                },
                                "secure": {
                                    "type": "boolean"
                                },
                                "signed": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "httpOnly",
                                "secure",
                                "signed"
                            ],
                            "type": "object"
                        },
                        "secret": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "policy",
                        "secret"
                    ],
                    "type": "object"
                },
                "http": {
                    "additionalProperties": false,
                    "properties": {
                        "port": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "port"
                    ],
                    "type": "object"
                },
                "session": {
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "secret": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "name",
                        "secret"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "cookie",
                "http",
                "session"
            ],
            "type": "object"
        },
        "IStorageConf": {
            "additionalProperties": false,
            "description": "当前地基闭环写入 Run、Trace 和页面观察的本地目录配置。",
            "properties": {
                "artifact_root": {
                    "type": "string"
                }
            },
            "required": [
                "artifact_root"
            ],
            "type": "object"
        },
        "ISystemConf": {
            "additionalProperties": false,
            "description": "服务运行环境、日志及可信代理等全局配置。",
            "properties": {
                "log": {
                    "additionalProperties": false,
                    "properties": {
                        "console": {
                            "$ref": "#/definitions/IConsoleLogConf"
                        },
                        "file": {
                            "$ref": "#/definitions/IFileLogConf"
                        }
                    },
                    "type": "object"
                },
                "req_log": {
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "enabled"
                    ],
                    "type": "object"
                },
                "timezone": {
                    "type": "string"
                },
                "trusted_proxy": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "required": [
                "log",
                "req_log",
                "timezone",
                "trusted_proxy"
            ],
            "type": "object"
        },
        "IVisualGroundingComponentConf": {
            "additionalProperties": false,
            "description": "Midscene 视觉模型配置；暂不代表视觉能力已进入执行链路。",
            "properties": {
                "api_key": {
                    "type": "string"
                },
                "base_url": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "model": {
                    "type": "string"
                },
                "model_family": {
                    "enum": [
                        "deepseek",
                        "gpt-5"
                    ],
                    "type": "string"
                },
                "provider": {
                    "const": "midscene",
                    "description": "当前视觉定位阶段固定使用 Midscene。",
                    "type": "string"
                },
                "reasoning_enabled": {
                    "type": "boolean"
                },
                "timeout_ms": {
                    "type": "number"
                }
            },
            "required": [
                "base_url",
                "enabled",
                "model",
                "model_family",
                "provider",
                "reasoning_enabled",
                "timeout_ms"
            ],
            "type": "object"
        },
        "LlmApiProtocol": {
            "description": "OpenAI-compatible Provider 支持的两种请求协议。",
            "enum": [
                "chat_completions",
                "responses"
            ],
            "type": "string"
        },
        "LlmProvider": {
            "description": "当前可选的本地订阅或 HTTP 模型 Provider。",
            "enum": [
                "codex_app_server",
                "openai_compatible"
            ],
            "type": "string"
        },
        "LlmReasoningEffort": {
            "description": "Codex 模型支持的推理强度。",
            "enum": [
                "high",
                "low",
                "max",
                "medium",
                "ultra",
                "xhigh"
            ],
            "type": "string"
        },
        "LlmServiceTier": {
            "const": "priority",
            "description": "Codex 可选的加速服务档位；未配置时使用账户默认档位。",
            "type": "string"
        },
        "VisualGroundingProvider": {
            "const": "midscene",
            "description": "当前视觉定位阶段固定使用 Midscene。",
            "type": "string"
        }
    }
}

