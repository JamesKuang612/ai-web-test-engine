{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Config": {
            "additionalProperties": false,
            "description": "聚合服务启动所需的系统、HTTP、存储和组件配置。",
            "properties": {
                "components": {
                    "$ref": "#/definitions/IComponentsConf"
                },
                "env": {
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                },
                "includes": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "server": {
                    "$ref": "#/definitions/IServerConf"
                },
                "storage": {
                    "$ref": "#/definitions/IStorageConf"
                },
                "system": {
                    "$ref": "#/definitions/ISystemConf"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "components",
                "env",
                "hostname",
                "server",
                "storage",
                "system",
                "version"
            ],
            "type": "object"
        },
        "IComponentsConf": {
            "additionalProperties": false,
            "description": "当前服务需要的可选组件配置集合。",
            "properties": {
                "llm": {
                    "$ref": "#/definitions/ILlmComponentConf"
                }
            },
            "required": [
                "llm"
            ],
            "type": "object"
        },
        "IConsoleLogConf": {
            "additionalProperties": false,
            "properties": {
                "colorize": {
                    "description": "开启彩色输出",
                    "type": "boolean"
                },
                "enabled": {
                    "description": "是否启用日志记录",
                    "type": "boolean"
                },
                "level": {
                    "description": "日志级别",
                    "type": "string"
                }
            },
            "required": [
                "enabled",
                "level"
            ],
            "type": "object"
        },
        "IFileLogConf": {
            "additionalProperties": false,
            "properties": {
                "dir": {
                    "description": "日志输出目录",
                    "type": "string"
                },
                "enabled": {
                    "description": "是否启用日志记录",
                    "type": "boolean"
                },
                "level": {
                    "description": "日志级别",
                    "type": "string"
                },
                "rotate_days": {
                    "description": "历史日志文件的保留天数。",
                    "type": "number"
                },
                "zip": {
                    "description": "是否压缩历史日志文件。",
                    "type": "boolean"
                }
            },
            "required": [
                "enabled",
                "level"
            ],
            "type": "object"
        },
        "ILlmComponentConf": {
            "additionalProperties": false,
            "description": "模型 Provider 配置；FineOne API Key 只允许由本机私有配置覆盖。",
            "properties": {
                "api_key": {
                    "type": "string"
                },
                "base_url": {
                    "type": "string"
                },
                "codex_command": {
                    "type": "string"
                },
                "model": {
                    "type": "string"
                },
                "protocol": {
                    "$ref": "#/definitions/LlmApiProtocol"
                },
                "provider": {
                    "$ref": "#/definitions/LlmProvider"
                },
                "reasoning_effort": {
                    "$ref": "#/definitions/LlmReasoningEffort"
                }
            },
            "required": [
                "api_key",
                "base_url",
                "codex_command",
                "model",
                "protocol",
                "provider",
                "reasoning_effort"
            ],
            "type": "object"
        },
        "IServerConf": {
            "additionalProperties": false,
            "description": "HTTP、Session 和 Cookie 相关的服务端配置。",
            "properties": {
                "cookie": {
                    "additionalProperties": false,
                    "properties": {
                        "policy": {
                            "additionalProperties": false,
                            "properties": {
                                "domain": {
                                    "type": "string"
                                },
                                "httpOnly": {
                                    "type": "boolean"
                                },
                                "maxAge": {
                                    "type": "number"
                                },
                                "secure": {
                                    "type": "boolean"
                                },
                                "signed": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "httpOnly",
                                "secure",
                                "signed"
                            ],
                            "type": "object"
                        },
                        "secret": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "policy",
                        "secret"
                    ],
                    "type": "object"
                },
                "http": {
                    "additionalProperties": false,
                    "properties": {
                        "port": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "port"
                    ],
                    "type": "object"
                },
                "session": {
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "secret": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "name",
                        "secret"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "cookie",
                "http",
                "session"
            ],
            "type": "object"
        },
        "IStorageConf": {
            "additionalProperties": false,
            "description": "预留给数据库或本地文件存储的配置集合。",
            "type": "object"
        },
        "ISystemConf": {
            "additionalProperties": false,
            "description": "服务运行环境、日志及可信代理等全局配置。",
            "properties": {
                "log": {
                    "additionalProperties": false,
                    "properties": {
                        "console": {
                            "$ref": "#/definitions/IConsoleLogConf"
                        },
                        "file": {
                            "$ref": "#/definitions/IFileLogConf"
                        }
                    },
                    "type": "object"
                },
                "req_log": {
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "enabled"
                    ],
                    "type": "object"
                },
                "timezone": {
                    "type": "string"
                },
                "trusted_proxy": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "required": [
                "log",
                "req_log",
                "timezone",
                "trusted_proxy"
            ],
            "type": "object"
        },
        "LlmApiProtocol": {
            "description": "FineOneAPI 当前支持的两种 OpenAI 兼容请求协议。",
            "enum": [
                "chat_completions",
                "responses"
            ],
            "type": "string"
        },
        "LlmProvider": {
            "description": "当前可选的本地订阅或 HTTP 模型 Provider。",
            "enum": [
                "codex_app_server",
                "fine_one"
            ],
            "type": "string"
        },
        "LlmReasoningEffort": {
            "description": "Codex 模型支持的推理强度。",
            "enum": [
                "high",
                "low",
                "max",
                "medium",
                "ultra",
                "xhigh"
            ],
            "type": "string"
        }
    }
}

